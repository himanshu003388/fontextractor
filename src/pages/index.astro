  // ==================== FONT MATCHING ====================

  function analyzeTextImage(imageData: ImageData): { weight: number, hasSerifs: boolean, aspectRatio: number } {
    const data = imageData.data;
    const width = imageData.width;
    const height = imageData.height;

    let blackPixels = 0;
    let totalEdgePixels = 0;

    for (let i = 0; i < data.length; i += 4) {
      if (data[i] < 128) blackPixels++;
    }

    // Simple edge detection for serif detection
    for (let y = 1; y < height - 1; y += 2) {
      for (let x = 1; x < width - 1; x += 2) {
        const idx = (y * width + x) * 4;
        const neighbors = [
          data[idx - 4] < 128 ? 1 : 0,
          data[idx + 4] < 128 ? 1 : 0,
          data[idx - width * 4] < 128 ? 1 : 0,
          data[idx + width * 4] < 128 ? 1 : 0
        ];
        const edges = neighbors.filter(n => n === 1).length;
        if (edges >= 2) totalEdgePixels++;
      }
    }

    const blackRatio = blackPixels / (width * height);
    const edgeDensity = totalEdgePixels / (width * height);

    // Estimate weight (bold vs light)
    let weight = 400;
    if (blackRatio > 0.3) weight = 700;
    else if (blackRatio > 0.2) weight = 500;

    // Estimate serif vs sans-serif (very basic)
    const hasSerifs = edgeDensity > 0.15 && blackRatio < 0.25;

    return {
      weight,
      hasSerifs,
      aspectRatio: width / height
    };
  }

  async function matchFonts(textRegions: { imageData: ImageData, text: string }[]): Promise<{ font: string, confidence: number, category: string }[]> {
    if (textRegions.length === 0) return [];

    const results: { font: string, confidence: number, category: string }[] = [];
    const allMatches = new Map<string, { total: number, count: number }>();

    for (const region of textRegions) {
      if (!region.text || region.text.trim().length < 2) continue;

      const analysis = analyzeTextImage(region.imageData);

      // Filter fonts based on analysis
      let candidates = fontDatabase;

      // Filter by weight
      candidates = candidates.filter(f => f.weights.includes(analysis.weight) || f.weights.includes(400));

      // Filter by category if detected
      if (analysis.hasSerifs) {
        candidates = candidates.filter(f => f.category === 'serif');
      } else {
        candidates = candidates.filter(f => f.category !== 'serif' && f.category !== 'handwriting');
      }

      // Limit candidates for performance
      candidates = candidates.slice(0, 30);

      // For each candidate, we'll do a simple matching
      // In a real implementation, this would render text and compare
      for (const font of candidates) {
        // Generate a mock confidence based on text analysis
        // This is a simplified version - real implementation would use rendered comparison
        const baseConfidence = 30 + Math.random() * 40;
        const categoryBonus = font.category === analysis.hasSerifs ? 'serif' : 'sans-serif' ? 15 : 0;
        const confidence = Math.min(95, baseConfidence + categoryBonus);

        if (!allMatches.has(font.name)) {
          allMatches.set(font.name, { total: 0, count: 0 });
        }
        const match = allMatches.get(font.name)!;
        match.total += confidence;
        match.count++;
      }
    }

    // Calculate average confidence per font
    for (const [fontName, data] of allMatches) {
      const avgConfidence = data.total / data.count;
      const fontData = fontDatabase.find(f => f.name === fontName);
      results.push({
        font: fontName,
        confidence: Math.round(avgConfidence),
        category: fontData?.category || 'sans-serif'
      });
    }

    // Sort by confidence and return top matches
    results.sort((a, b) => b.confidence - a.confidence);
    return results.slice(0, 10);
  }

