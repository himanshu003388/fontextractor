    // Apply Google Fonts only filter
    if (googleFontsOnly) {
      filtered = filtered.filter(f => f.isGoogleFont);
    }

    // Apply sorting
    if (currentSort === 'az') {
      filtered.sort((a, b) => a.font.localeCompare(b.font));
    } else if (currentSort === 'za') {
      filtered.sort((a, b) => b.font.localeCompare(a.font));
