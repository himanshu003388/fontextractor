  // Display bounding boxes on original image
  function displayBoundingBoxes(regions: { x: number, y: number, width: number, height: number }[], results: { text: string, confidence: number }[], scaleFactor: number = 1) {
    const canvas = boundingBoxesCanvas;
    const ctx = canvas.getContext('2d')!;

    canvas.width = originalImageWidth;
    canvas.height = originalImageHeight;
    canvas.style.width = `${originalImageWidth * scaleFactor}px`;
    canvas.style.height = `${originalImageHeight * scaleFactor}px`;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (!showBoundingBoxes) return;

    regions.forEach((region, index) => {
      const isSelected = selectedRegions.has(index);
      const result = results[index];

      // Draw bounding box
      ctx.strokeStyle = isSelected ? '#ff4f00' : 'rgba(255, 255, 255, 0.6)';
      ctx.lineWidth = isSelected ? 3 : 2;
      ctx.setLineDash(isSelected ? [] : [5, 5]);
      ctx.strokeRect(region.x, region.y, region.width, region.height);

      // Draw label
      if (result) {
        ctx.fillStyle = isSelected ? '#ff4f00' : 'rgba(0, 0, 0, 0.7)';
        ctx.fillRect(region.x, region.y - 20, Math.min(region.width, 100), 20);
        ctx.fillStyle = '#fff';
        ctx.font = '12px monospace';
        const label = result.text.substring(0, 15) + (result.text.length > 15 ? '...' : '');
        ctx.fillText(label, region.x + 5, region.y - 5);
      }
    });

    ctx.setLineDash([]);
  }

  // Display extracted text panel with interactive regions
  function displayExtractedTextPanel(regions: { x: number, y: number, width: number, height: number }[], results: { text: string, confidence: number }[]) {
    extractedTextPanel.classList.remove('hidden');
    imagePreviewContainer.classList.remove('hidden');
    textRegionsList.innerHTML = '';

    selectedRegions.clear();
    let totalChars = 0;
    let totalConf = 0;

    regions.forEach((region, index) => {
      const result = results[index];
      if (!result) return;

      totalChars += result.text.length;
      totalConf += result.confidence;

      const div = document.createElement('div');
      div.className = 'bg-[#0a0a0a] border border-[#222] p-3 cursor-pointer hover:border-primary transition-colors';
      div.dataset.index = index.toString();

      const isSelected = selectedRegions.has(index);
      div.classList.toggle('border-primary', isSelected);
      div.classList.toggle('bg-[#121212]', isSelected);

      const confidenceColor = result.confidence >= 70 ? 'text-green-500' : result.confidence >= 40 ? 'text-yellow-500' : 'text-red-500';

      div.innerHTML = `
        <div class="flex justify-between items-start mb-2">
          <div class="flex items-center gap-2">
            <input type="checkbox" class="region-checkbox accent-primary" data-index="${index}" ${isSelected ? 'checked' : ''}>
            <span class="font-mono text-xs text-neutral-500">Region ${index + 1}</span>
          </div>
          <span class="font-mono text-xs ${confidenceColor}">${Math.round(result.confidence)}%</span>
        </div>
        <p class="font-mono text-sm text-neutral-300 whitespace-pre-wrap">${result.text}</p>
        <div class="mt-2 flex justify-between items-center">
          <span class="font-mono text-[10px] text-neutral-600">${region.width}×${region.height}px</span>
          <button class="copy-region-btn font-mono text-[10px] text-primary hover:underline" data-index="${index}">Copy</button>
        </div>
      `;

      // Click to select
      div.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).classList.contains('copy-region-btn') ||
            (e.target as HTMLElement).classList.contains('region-checkbox')) return;
        toggleRegionSelection(index);
      });

      textRegionsList.appendChild(div);
    });

    // Update stats
    const avgConf = results.length > 0 ? Math.round(totalConf / results.length) : 0;
    totalRegionsStat.textContent = `Regions: ${results.length}`;
    totalTextStat.textContent = `Characters: ${totalChars}`;
    avgConfidenceStat.textContent = `Avg Confidence: ${avgConf}%`;
    languageStat.textContent = `Language: English`;

    updateSelectionInfo();
    updateCombinedText();
  }

  // Toggle region selection
  function toggleRegionSelection(index: number) {
    if (selectedRegions.has(index)) {
      selectedRegions.delete(index);
    } else {
      selectedRegions.add(index);
    }

    // Update UI
    const regionDiv = textRegionsList.querySelector(`[data-index="${index}"]`) as HTMLElement;
    if (regionDiv) {
      regionDiv.classList.toggle('border-primary', selectedRegions.has(index));
      regionDiv.classList.toggle('bg-[#121212]', selectedRegions.has(index));
      const checkbox = regionDiv.querySelector('.region-checkbox') as HTMLInputElement;
      if (checkbox) checkbox.checked = selectedRegions.has(index);
    }

    // Update bounding boxes
    if (ocrResults.length > 0) {
      const regions = detectedTextRegions.map(r => ({ x: r.x, y: r.y, width: r.width, height: r.height }));
      const results = ocrResults.map(r => ({ text: r.text, confidence: r.confidence }));
      displayBoundingBoxes(regions, results);
    }

    updateSelectionInfo();
    updateCombinedText();
  }

  // Update selection info
  function updateSelectionInfo() {
    selectionInfo.classList.toggle('hidden', selectedRegions.size === 0);
    selectionCount.textContent = `${selectedRegions.size} region${selectedRegions.size !== 1 ? 's' : ''} selected`;
  }

  // Update combined text output
  function updateCombinedText() {
    const sortedIndices = Array.from(selectedRegions).sort((a, b) => {
      const regionA = detectedTextRegions[a];
      const regionB = detectedTextRegions[b];
      const rowA = Math.floor(regionA.y / 50);
      const rowB = Math.floor(regionB.y / 50);
      if (rowA !== rowB) return rowA - rowB;
      return regionA.x - regionB.x;
    });

    const text = sortedIndices.map(i => ocrResults[i]?.text || '').join(' ');
    combinedTextOutput.value = text;
  }

  // Copy functions
  async function copyPlainText() {
    const sortedIndices = Array.from(selectedRegions).sort((a, b) => {
      const regionA = detectedTextRegions[a];
      const regionB = detectedTextRegions[b];
      const rowA = Math.floor(regionA.y / 50);
      const rowB = Math.floor(regionB.y / 50);
      if (rowA !== rowB) return rowA - rowB;
      return regionA.x - regionB.x;
    });

    const text = sortedIndices.map(i => ocrResults[i]?.text || '').join(' ');
    await navigator.clipboard.writeText(text);
    showCopyFeedback(copyPlainTextBtn);
  }

  async function copyWithBreaks() {
    const sortedIndices = Array.from(selectedRegions).sort((a, b) => {
      const regionA = detectedTextRegions[a];
      const regionB = detectedTextRegions[b];
      const rowA = Math.floor(regionA.y / 50);
      const rowB = Math.floor(regionB.y / 50);
      if (rowA !== rowB) return rowA - rowB;
      return regionA.x - regionB.x;
    });

    let lastRow = -1;
    const lines: string[] = [];
    let currentLine = '';

    sortedIndices.forEach(i => {
      const region = detectedTextRegions[i];
      const row = Math.floor(region.y / 50);
      const text = ocrResults[i]?.text || '';

      if (row !== lastRow && lastRow !== -1) {
        if (currentLine) lines.push(currentLine);
        currentLine = text;
      } else {
        currentLine += (currentLine ? ' ' : '') + text;
      }
      lastRow = row;
    });
    if (currentLine) lines.push(currentLine);

    await navigator.clipboard.writeText(lines.join('\n'));
    showCopyFeedback(copyWithBreaksBtn);
  }

  async function copyJson() {
    const data = Array.from(selectedRegions).map(i => ({
      region: i,
      text: ocrResults[i]?.text || '',
      confidence: ocrResults[i]?.confidence || 0,
      bbox: {
        x: detectedTextRegions[i].x,
        y: detectedTextRegions[i].y,
        width: detectedTextRegions[i].width,
        height: detectedTextRegions[i].height
      }
    }));

    await navigator.clipboard.writeText(JSON.stringify(data, null, 2));
    showCopyFeedback(copyJsonBtn);
  }

  function showCopyFeedback(btn: HTMLElement) {
    const originalText = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = originalText; }, 1500);
  }

  // Search functionality
  function setupSearch() {
    searchContainer.classList.remove('hidden');

    const allText = ocrResults.map(r => r.text).join(' ').toLowerCase();

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      if (!query) {
        searchCount.textContent = '';
        searchMatches = [];
        return;
      }

      // Find all regions containing the search term
      searchMatches = [];
      ocrResults.forEach((result, index) => {
        if (result.text.toLowerCase().includes(query)) {
          searchMatches.push(index);
        }
      });

      searchIndex = 0;
      updateSearchHighlight();
    });

    searchPrevBtn.addEventListener('click', () => {
      if (searchMatches.length === 0) return;
      searchIndex = (searchIndex - 1 + searchMatches.length) % searchMatches.length;
      updateSearchHighlight();
    });

    searchNextBtn.addEventListener('click', () => {
      if (searchMatches.length === 0) return;
      searchIndex = (searchIndex + 1) % searchMatches.length;
      updateSearchHighlight();
    });
  }

  function updateSearchHighlight() {
    searchCount.textContent = searchMatches.length > 0 ? `${searchIndex + 1}/${searchMatches.length}` : '0/0';

    // Scroll to match
    if (searchMatches.length > 0) {
      const idx = searchMatches[searchIndex];
      const regionDiv = textRegionsList.querySelector(`[data-index="${idx}"]`) as HTMLElement;
      if (regionDiv) {
        regionDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        regionDiv.classList.add('ring-2', 'ring-primary');
        setTimeout(() => regionDiv.classList.remove('ring-2', 'ring-primary'), 2000);
      }

      // Highlight in bounding box
      if (ocrResults.length > 0) {
        const regions = detectedTextRegions.map(r => ({ x: r.x, y: r.y, width: r.width, height: r.height }));
        const results = ocrResults.map(r => ({ text: r.text, confidence: r.confidence }));
        displayBoundingBoxes(regions, results);

        // Draw highlight on canvas
        const ctx = boundingBoxesCanvas.getContext('2d')!;
        if (showBoundingBoxes && searchMatches.length > 0) {
          const region = detectedTextRegions[searchMatches[searchIndex]];
          ctx.strokeStyle = '#ff4f00';
          ctx.lineWidth = 4;
          ctx.strokeRect(region.x - 2, region.y - 2, region.width + 4, region.height + 4);
        }
      }
    }
  }

  // Manual crop functionality
  function openManualCrop() {
    if (!originalImageCanvas) return;

    manualCropModal.classList.remove('hidden');

    const ctx = cropCanvas.getContext('2d')!;
    cropCanvas.width = originalImageWidth;
    cropCanvas.height = originalImageHeight;
    ctx.drawImage(originalImageCanvas, 0, 0);

    cropSelection.classList.add('hidden');
    cropRect = { x: 0, y: 0, width: 0, height: 0 };
  }

  function closeManualCrop() {
    manualCropModal.classList.add('hidden');
  }

  // Crop selection handling
  cropCanvasWrapper.addEventListener('mousedown', (e) => {
    const rect = cropCanvasWrapper.getBoundingClientRect();
    const scaleX = cropCanvas.width / rect.width;
    const scaleY = cropCanvas.height / rect.height;

    cropStartX = (e.clientX - rect.left) * scaleX;
    cropStartY = (e.clientY - rect.top) * scaleY;
    isDraggingCrop = true;

    cropSelection.classList.remove('hidden');
    cropSelection.style.left = `${e.clientX - rect.left}px`;
    cropSelection.style.top = `${e.clientY - rect.top}px`;
    cropSelection.style.width = '0px';
    cropSelection.style.height = '0px';
  });

  cropCanvasWrapper.addEventListener('mousemove', (e) => {
    if (!isDraggingCrop) return;

    const rect = cropCanvasWrapper.getBoundingClientRect();
    const scaleX = cropCanvas.width / rect.width;
    const scaleY = cropCanvas.height / rect.height;

    const currentX = (e.clientX - rect.left) * scaleX;
    const currentY = (e.clientY - rect.top) * scaleY;

    const x = Math.min(cropStartX, currentX);
    const y = Math.min(cropStartY, currentY);
    const width = Math.abs(currentX - cropStartX);
    const height = Math.abs(currentY - cropStartY);

    cropRect = { x, y, width, height };

    // Update visual selection
    const displayScale = rect.width / cropCanvas.width;
    cropSelection.style.left = `${x * displayScale}px`;
    cropSelection.style.top = `${y * displayScale}px`;
    cropSelection.style.width = `${width * displayScale}px`;
    cropSelection.style.height = `${height * displayScale}px`;
  });

  cropCanvasWrapper.addEventListener('mouseup', () => {
    isDraggingCrop = false;
  });

  async function runOcrOnCrop() {
    if (cropRect.width < 10 || cropRect.height < 10) {
      showError('Please select a larger region', 'warning');
      return;
    }

    closeManualCrop();

    // Create cropped image
    const croppedCanvas = document.createElement('canvas');
    croppedCanvas.width = cropRect.width;
    croppedCanvas.height = cropRect.height;
    const ctx = croppedCanvas.getContext('2d')!;
    ctx.drawImage(originalImageCanvas!, cropRect.x, cropRect.y, cropRect.width, cropRect.height, 0, 0, cropRect.width, cropRect.height);

    const croppedImageData = croppedCanvas.toDataURL('image/png');

    // Run OCR on cropped region
    updateProgress('Running OCR on cropped region...', 50);

    try {
      const { createWorker } = await import('tesseract.js');
      const worker = await createWorker('eng', 1);
      const { data } = await worker.recognize(croppedImageData);
      await worker.terminate();

      if (data.text.trim()) {
        // Add new result
        ocrResults.push({
          region: { x: cropRect.x, y: cropRect.y, width: cropRect.width, height: cropRect.height, imageData: croppedImageData },
          text: data.text.trim(),
          confidence: data.confidence
        });

        detectedTextRegions.push({
          x: cropRect.x, y: cropRect.y, width: cropRect.width, height: cropRect.height, imageData: croppedImageData
        });

        // Update display
        const regions = detectedTextRegions.map(r => ({ x: r.x, y: r.y, width: r.width, height: r.height }));
        const results = ocrResults.map(r => ({ text: r.text, confidence: r.confidence }));

        displayBoundingBoxes(regions, results);
        displayExtractedTextPanel(regions, results);
        displayDetectedRegions(regions, results);

        showError(`Added text: "${data.text.trim().substring(0, 50)}..."`, 'warning');
      } else {
        showError('No text detected in selected region', 'warning');
      }
    } catch (err) {
      showError('OCR failed on cropped region', 'error');
    }
  }

  // Event listeners for new features
  toggleOverlayBtn.addEventListener('click', () => {
    showBoundingBoxes = !showBoundingBoxes;
    if (ocrResults.length > 0) {
      const regions = detectedTextRegions.map(r => ({ x: r.x, y: r.y, width: r.width, height: r.height }));
      const results = ocrResults.map(r => ({ text: r.text, confidence: r.confidence }));
      displayBoundingBoxes(regions, results);
    }
  });

  manualCropBtn.addEventListener('click', openManualCrop);
  closeCropModalBtn.addEventListener('click', closeManualCrop);
  cancelCropBtn.addEventListener('click', closeManualCrop);
  runOcrOnCropBtn.addEventListener('click', runOcrOnCrop);

  selectAllTextBtn.addEventListener('click', () => {
    ocrResults.forEach((_, index) => selectedRegions.add(index));
    const regions = detectedTextRegions.map(r => ({ x: r.x, y: r.y, width: r.width, height: r.height }));
    const results = ocrResults.map(r => ({ text: r.text, confidence: r.confidence }));
    displayBoundingBoxes(regions, results);
    displayExtractedTextPanel(regions, results);
  });

  searchTextBtn.addEventListener('click', () => {
    searchContainer.classList.toggle('hidden');
    if (!searchContainer.classList.contains('hidden')) {
      searchInput.focus();
    }
  });

  copyPlainTextBtn.addEventListener('click', copyPlainText);
  copyWithBreaksBtn.addEventListener('click', copyWithBreaks);
  copyJsonBtn.addEventListener('click', copyJson);

  copyCombinedBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(combinedTextOutput.value);
    showCopyFeedback(copyCombinedBtn);
  });

  // Handle image resize for bounding boxes
  originalImagePreview.addEventListener('load', () => {
    const rect = originalImagePreview.getBoundingClientRect();
    const scaleFactor = originalImagePreview.naturalWidth > 0 ? rect.width / originalImagePreview.naturalWidth : 1;

    if (ocrResults.length > 0) {
      const regions = detectedTextRegions.map(r => ({ x: r.x, y: r.y, width: r.width, height: r.height }));
      const results = ocrResults.map(r => ({ text: r.text, confidence: r.confidence }));
      displayBoundingBoxes(regions, results, scaleFactor);
    }
  });

  // Display font match results
  function displayFontMatches(matches: { font: string, confidence: number, category: string }[]) {
    fontMatchResults.classList.remove('hidden');
    fontMatchesContainer.innerHTML = '';

    // Add detected fonts to currentFonts for export
    currentFonts = matches.map(m => m.font);

    if (matches.length > 0) {
      exportTailwindBtn.classList.remove('hidden');
      exportCssBtn.classList.remove('hidden');
    }

    matches.forEach((match, index) => {
      const card = document.createElement('div');
      card.className = 'bg-[#121212] border border-[#222] p-4 hover:border-primary transition-colors';

      // Load font
      const fontLink = document.createElement('link');
      fontLink.href = `https://fonts.googleapis.com/css2?family=${match.font.replace(/\s+/g, '+')}&display=swap`;
      fontLink.rel = 'stylesheet';
      document.head.appendChild(fontLink);

      const confidenceColor = match.confidence >= 70 ? 'text-green-500' : match.confidence >= 40 ? 'text-yellow-500' : 'text-red-500';
      const confidenceBar = `<div class="h-1 bg-[#222] rounded mt-2 overflow-hidden"><div class="h-full ${match.confidence >= 70 ? 'bg-green-500' : match.confidence >= 40 ? 'bg-yellow-500' : 'bg-red-500'}" style="width: ${match.confidence}%"></div></div>`;

      card.innerHTML = `
        <div class="flex items-start justify-between mb-3">
          <div>
            <div class="font-display text-lg text-white">${match.font}</div>
            <div class="font-mono text-xs text-neutral-500 uppercase">${match.category}</div>
          </div>
          <div class="text-right">
            <div class="font-mono text-2xl ${confidenceColor}">${match.confidence}%</div>
            ${confidenceBar}
          </div>
        </div>
        <div class="text-xl text-neutral-300" style="font-family: '${match.font}', sans-serif;">
          The quick brown fox jumps over the lazy dog
        </div>
        <div class="mt-3 pt-3 border-t border-[#222] flex justify-between items-center">
          <a href="https://fonts.google.com/specimen/${match.font.replace(/\s+/g, '+')}" target="_blank" class="font-mono text-xs text-primary hover:underline">View on Google Fonts</a>
        </div>
      `;

      fontMatchesContainer.appendChild(card);
    });
  }

  // Full image extraction process
  async function performFullExtraction() {
    if (!selectedImage) {
      showError('Please select an image first');
      return;
    }

    ocrBtn.disabled = true;
    ocrBtnText.textContent = 'Processing...';
    ocrBtnIcon.classList.add('hidden');
    ocrLoadingIcon.classList.remove('hidden');
    errorMessage.classList.add('hidden');
    resultsArea.classList.add('hidden');
    fontMatchResults.classList.add('hidden');
    extractedTextPanel.classList.add('hidden');
    imagePreviewContainer.classList.add('hidden');
    processingProgress.classList.remove('hidden');

    // Reset
    selectedRegions.clear();
    ocrResults = [];

    try {
      // Load image
      updateProgress('Loading image...', 10);

      const reader = new FileReader();
      const imageDataUrl = await new Promise<string>((resolve, reject) => {
        reader.onload = () => resolve(reader.result as string);
        reader.onerror = reject;
        reader.readAsDataURL(selectedImage);
      });

      const img = new Image();
      await new Promise((resolve, reject) => {
        img.onload = resolve;
        img.onerror = reject;
        img.src = imageDataUrl;
      });

      // Store original dimensions
      originalImageWidth = img.width;
      originalImageHeight = img.height;

      // Show dimensions in preview
      const imageDimensions = document.getElementById('imageDimensions') as HTMLElement;
      if (imageDimensions) {
        imageDimensions.textContent = `${img.width} × ${img.height}`;
      }

      // Preprocess (keep original for display, process for OCR)
      const { original, processed } = await preprocessImage(img);
      originalImageCanvas = original;
      processedImageCanvas = processed;

      // Show original image with bounding boxes (not preprocessed)
      originalImagePreview.src = imageDataUrl;
      imagePreviewContainer.classList.remove('hidden');

      // Detect text regions on preprocessed image (but use original for OCR)
      const regions = await detectTextRegions(processed, original);
      detectedTextRegions = regions;

      // Run OCR on regions
      updateProgress('Running OCR...', 70);
      const ocrResultsRaw = await runOCROnRegions(regions);
      ocrResults = ocrResultsRaw;

      // Display bounding boxes on original image
      if (ocrResultsRaw.length > 0) {
        const regionsData = detectedTextRegions.map(r => ({ x: r.x, y: r.y, width: r.width, height: r.height }));
        const resultsData = ocrResultsRaw.map(r => ({ text: r.text, confidence: r.confidence }));

        // Get scale factor from displayed image
        setTimeout(() => {
          const rect = originalImagePreview.getBoundingClientRect();
          const scaleFactor = originalImageWidth > 0 && rect.width > 0 ? rect.width / originalImageWidth : 1;
          displayBoundingBoxes(regionsData, resultsData, scaleFactor);
          displayExtractedTextPanel(regionsData, resultsData);
        }, 100);
      } else {
        showError('[INFO] No text detected. Try adjusting preprocessing or using a clearer image.', 'warning');
      }

      // Match fonts
      updateProgress('Matching fonts...', 90);

      const textRegionsWithImageData = await Promise.all(ocrResultsRaw.map(async (result) => {
        const regionCanvas = document.createElement('canvas');
        regionCanvas.width = result.region.width;
        regionCanvas.height = result.region.height;
        const ctx = regionCanvas.getContext('2d')!;
        
        const imgObj = new Image();
        imgObj.src = result.region.imageData;
        await new Promise((resolve) => {
          imgObj.onload = resolve;
          imgObj.onerror = resolve; // Continue even if error
        });
        
        ctx.drawImage(imgObj, 0, 0);
        const imageData = ctx.getImageData(0, 0, regionCanvas.width, regionCanvas.height);

        return { imageData, text: result.text };
      }));

      const fontMatches = await matchFonts(textRegionsWithImageData);

      // Display results
      if (fontMatches.length > 0) {
        displayFontMatches(fontMatches);
        resultCount.textContent = `${fontMatches.length} Font Matches Found`;
      } else if (ocrResultsRaw.length > 0) {
        const allText = ocrResultsRaw.map(r => r.text).join(' ');
        if (allText) {
          resultCount.textContent = `Text Extracted • ${Math.round(ocrResultsRaw.reduce((a, b) => a + b.confidence, 0) / ocrResultsRaw.length)}%`;
        }
      }

    } catch (error: any) {
      console.error('Extraction Error:', error);
      showError(`[ERROR] ${error.message || 'Failed to process image'}`);
    } finally {
      ocrBtn.disabled = false;
      ocrBtnText.textContent = 'Extract Text & Fonts';
      ocrLoadingIcon.classList.add('hidden');
      ocrBtnIcon.classList.remove('hidden');
      processingProgress.classList.add('hidden');
    }
  }

  // Simple OCR (fallback for direct extraction)
  async function performOCR() {
    if (!selectedImage) {
      showError('Please select an image first');
      return;
    }

    ocrBtn.disabled = true;
    ocrBtnText.textContent = 'Processing...';
    ocrBtnIcon.classList.add('hidden');
    ocrLoadingIcon.classList.remove('hidden');
    errorMessage.classList.add('hidden');
    resultsArea.classList.add('hidden');
    fontMatchResults.classList.add('hidden');

    try {
      const reader = new FileReader();
      const imageDataUrl = await new Promise<string>((resolve, reject) => {
        reader.onload = () => resolve(reader.result as string);
        reader.onerror = reject;
        reader.readAsDataURL(selectedImage);
      });

      const { createWorker } = await import('tesseract.js');
      const worker = await createWorker('eng', 1, {
        logger: (m: any) => {
          if (m.status === 'recognizing text') {
            ocrBtnText.textContent = `${Math.round(m.progress * 100)}%`;
          }
        }
      });

      const { data } = await worker.recognize(imageDataUrl);
      await worker.terminate();

      const extractedText = data.text.trim();

      if (extractedText) {
        let detectedFont: string | null = null;
        if (data.words && data.words.length > 0) {
          for (const word of data.words) {
            if (word.font_name && word.font_name !== 'Unknown' && word.font_name.length > 2) {
              detectedFont = word.font_name.replace(/_/g, ' ');
              break;
            }
          }
        }

        if (detectedFont && detectedFont !== 'Unknown') {
          try {
            const fontLink = document.createElement('link');
            fontLink.href = `https://fonts.googleapis.com/css2?family=${detectedFont.replace(/\s+/g, '+')}&display=swap`;
            fontLink.rel = 'stylesheet';
            document.head.appendChild(fontLink);
          } catch {}

          currentFonts = [detectedFont];
          exportTailwindBtn.classList.remove('hidden');
          exportCssBtn.classList.remove('hidden');
        } else {
          currentFonts = [];
          exportTailwindBtn.classList.add('hidden');
          exportCssBtn.classList.add('hidden');
        }

        resultCount.textContent = detectedFont
          ? `Font Detected: ${detectedFont} • ${Math.round(data.confidence)}%`
          : `Text Extracted • ${Math.round(data.confidence)}% confidence`;

        fontsGrid.innerHTML = '';

        const card = document.createElement('div');
        card.className = 'bg-[#121212] border border-[#222] p-6 hover:border-primary transition-colors group relative overflow-hidden cursor-pointer';

        const bgPattern = document.createElement('div');
        bgPattern.className = 'absolute inset-0 opacity-0 group-hover:opacity-10 transition-opacity bg-[radial-gradient(#ff4f00_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none';
        card.appendChild(bgPattern);

        const fontLabel = detectedFont || 'Image Text';
        const fontStyle = detectedFont
          ? `style="font-family: '${detectedFont}', sans-serif;"`
          : 'class="font-mono text-neutral-300"';

        card.innerHTML += `
          <div class="relative z-10">
            <div class="font-mono text-[10px] text-neutral-500 mb-4 uppercase flex justify-between">
              <span>${detectedFont ? 'Family (Detected)' : 'Source'}</span>
              <span class="text-primary hidden group-hover:inline-block">Click to Copy Text</span>
            </div>
            <h3 class="font-display text-2xl text-white mb-2 truncate" title="${fontLabel}">${fontLabel}</h3>
            <p class="text-xl mt-6 line-clamp-3" ${fontStyle}>${extractedText}</p>

            <div class="mt-4 pt-4 border-t border-[#222] flex justify-between items-center">
              <span class="text-[10px] font-mono text-neutral-600 uppercase">OCR Confidence</span>
              <span class="text-[10px] font-mono text-primary">${Math.round(data.confidence)}%</span>
            </div>
          </div>
        `;

        card.addEventListener('click', () => {
          navigator.clipboard.writeText(extractedText);
          const header = card.querySelector('h3');
          if (header) {
            const originalText = header.textContent;
            header.textContent = 'Text Copied!';
            header.classList.add('text-primary');
            setTimeout(() => {
              header.textContent = originalText;
              header.classList.remove('text-primary');
            }, 1500);
          }
        });

        fontsGrid.appendChild(card);
        resultsArea.classList.remove('hidden');
      } else {
        showError('[INFO] No text detected in the image', 'warning');
      }
    } catch (error: any) {
      console.error('OCR Error:', error);
      showError(`[ERROR] ${error.message || 'Failed to process image'}`);
    } finally {
      ocrBtn.disabled = false;
      ocrBtnText.textContent = 'Extract Text';
      ocrLoadingIcon.classList.add('hidden');
      ocrBtnIcon.classList.remove('hidden');
    }
  }

  if (ocrBtn) ocrBtn.addEventListener('click', performFullExtraction);

  if (rerunDetectionBtn) {
    rerunDetectionBtn.addEventListener('click', async () => {
      if (processedImageCanvas && originalImageCanvas) {
        const regions = await detectTextRegions(processedImageCanvas, originalImageCanvas);
        detectedTextRegions = regions;
        displayDetectedRegions(regions);
      }
    });
  }

  function showError(msg: string, type: 'error' | 'warning' = 'error') {
    errorMessage.textContent = msg;
    errorMessage.classList.remove('hidden', 'text-red-500', 'text-yellow-500', 'border-red-500/30', 'border-yellow-500/30', 'bg-red-500/10', 'bg-yellow-500/10');
    if (type === 'warning') {
      errorMessage.classList.add('text-yellow-500', 'border-yellow-500/30', 'bg-yellow-500/10');
    } else {
      errorMessage.classList.add('text-red-500', 'border-red-500/30', 'bg-red-500/10');
    }
  }

  async function performExtraction() {
    const url = input.value.trim();
    if (!url) {
      showError('Please enter a URL');
      return;
    }

    console.log('performExtraction called, url:', url);

    btn.disabled = true;
    btnText.textContent = 'Scanning...';
    btnIcon.classList.add('hidden');
    loadingIcon.classList.remove('hidden');
    errorMessage.classList.add('hidden');
    resultsArea.classList.add('hidden');
    if (fontFilterBar) fontFilterBar.classList.add('hidden');
    fontsGrid.innerHTML = '';
    urlModeFonts = [];

    exportTailwindBtn.classList.add('hidden');
    exportCssBtn.classList.add('hidden');

    try {
      const response = await fetch('/api/extract', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Failed to extract fonts');
      }

      if (data.fonts && data.fonts.length > 0) {
        addRecentScan(url);

        currentFonts = data.fonts;
        exportTailwindBtn.classList.remove('hidden');
        exportCssBtn.classList.remove('hidden');

        // Store preview text globally for filtering
        (window as any).__previewText = data.previewText || "The quick brown fox jumps over the lazy dog.";

        resultCount.textContent = `${data.fonts.length} Fonts Found on ${data.siteTitle || 'Target'}`;

        // Build font data with Google Fonts detection
        const knownGoogleFonts = new Set(fontDatabase.map(f => f.name.toLowerCase()));

        function isLikelyGoogleFont(fontName: string): boolean {
          const lower = fontName.toLowerCase();
          if (knownGoogleFonts.has(lower)) return true;
          const googlePatterns = ['roboto', 'open sans', 'lato', 'montserrat', 'oswald', 'raleway', 'poppins', 'source', 'ubuntu', 'merriweather', 'playfair', 'lora', 'inter', 'nunito', 'rubik', 'work sans', ' DM ', 'IBM', 'sora', 'outfit', 'space mono', 'jetbrains', 'fira code', 'crimson', 'libre', 'noto', 'PT ', 'archivo', 'anton', 'bebas', 'comfortaa', 'lobster', 'pacifico', 'dancing', 'caveat', 'fredoka', 'lexend', 'fraunces', 'cormorant', 'eb garamond', 'spectral', 'newsreader', 'titillium', 'heebo', 'maven', 'mukta', 'barlow', 'syne', 'epilogue', 'plus jakarta', 'red hat', 'tenor', 'spline', 'cabin', 'josefin', 'karla', 'quicksand', 'hind', 'catamaran', 'cantarell', 'albert', 'bitter', 'cardo', 'arvo'];
          return googlePatterns.some(p => lower.includes(p));
        }

        urlModeFonts = data.fonts.map((font: string) => ({
          font: font.replace(/["']/g, ''),
          isGoogleFont: isLikelyGoogleFont(font)
        }));

        // Show filter bar and reset filters
        if (fontFilterBar) fontFilterBar.classList.remove('hidden');
        if (fontSearchInput) fontSearchInput.value = '';
        if (fontSortSelect) fontSortSelect.value = 'original';
        if (googleFontsOnlyCheckbox) googleFontsOnlyCheckbox.checked = false;
        currentSort = 'original';
        currentSearch = '';
        googleFontsOnly = false;

        // Render all fonts using the filter/sort system
        filterAndSortFonts();

        resultsArea.classList.remove('hidden');
      } else {
        showError('[INFO] No custom fonts detected at coordinates.', 'warning');
      }

    } catch (error: any) {
      console.error(error);
      showError(`[ERROR] ${error.message}`);
    } finally {
      btn.disabled = false;
      btnText.textContent = 'Initiate Scan';
      loadingIcon.classList.add('hidden');
      btnIcon.classList.remove('hidden');
    }
  }

  // Add direct event listener with logging - wrap in DOMContentLoaded
  document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM ready, setting up event listeners...');

    if (btn) {
      btn.addEventListener('click', function(e) {
        console.log('Button clicked!', e);
        performExtraction();
      });
      console.log('Button click handler attached');
    } else {
      console.error('Button not found at DOMContentLoaded');
    }

    if (input) {
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          console.log('Enter pressed, triggering extraction');
          performExtraction();
        }
      });
    }
  });

  // Also try setting up immediately in case DOM is already loaded
  setTimeout(() => {
    if (btn && !btn.onclick) {
      console.log('Setting up button handler via setTimeout');
      btn.onclick = function(e) {
        console.log('Button clicked via onclick!', e);
        performExtraction();
      };
    }
  }, 100);

  // Expose performExtraction to window for inline onclick
  (window as any).performExtraction = performExtraction;

  // Initial log to confirm script loaded
  console.log('Fontextractor script loaded successfully');
</script>