  // Image preprocessing pipeline
  async function preprocessImage(img: HTMLImageElement): Promise<{ original: HTMLCanvasElement, processed: HTMLCanvasElement }> {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d')!;

    canvas.width = img.width;
    canvas.height = img.height;
    ctx.drawImage(img, 0, 0);

    const originalCanvas = document.createElement('canvas');
    originalCanvas.width = img.width;
    originalCanvas.height = img.height;
    originalCanvas.getContext('2d')!.drawImage(img, 0, 0);

    let imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);

    // Apply preprocessing steps
    if (preprocessGrayscale.checked) {
      updateProgress('Converting to grayscale...', 20);
      imageData = toGrayscale(imageData);
    }

    if (preprocessContrast.checked) {
      updateProgress('Enhancing contrast...', 40);
      imageData = enhanceContrast(imageData);
    }

    if (preprocessDenoise.checked) {
      updateProgress('Denoising...', 60);
      imageData = denoise(imageData);
    }

    if (preprocessThreshold.checked) {
      updateProgress('Applying threshold...', 80);
      imageData = threshold(imageData);
    }

    ctx.putImageData(imageData, 0, 0);

    return { original: originalCanvas, processed: canvas };
  }

  // Detect text regions - use original image for better OCR accuracy
  async function detectTextRegions(processedCanvas: HTMLCanvasElement, originalCanvas: HTMLCanvasElement): Promise<{ x: number, y: number, width: number, height: number, imageData: string }[]> {
    updateProgress('Detecting text regions...', 50);

    // Use processed canvas for detection but original for OCR
    const ctx = processedCanvas.getContext('2d')!;
    const imageData = ctx.getImageData(0, 0, processedCanvas.width, processedCanvas.height);

    // Detect edges
    const edgeData = detectEdges(imageData);

    // Find text regions - use more lenient parameters
    const regions = findTextRegions(edgeData, 20, 10);

    // Convert to image data URLs - use ORIGINAL image for better OCR
    const results: { x: number, y: number, width: number, height: number, imageData: string }[] = [];
    const origCtx = originalCanvas.getContext('2d')!;

    for (const region of regions) {
      // Expand region slightly
      const padX = Math.min(8, region.x);
      const padY = Math.min(8, region.y);
      const x = Math.max(0, region.x - padX);
      const y = Math.max(0, region.y - padY);
      const w = Math.min(processedCanvas.width - x, region.width + padX * 2);
      const h = Math.min(processedCanvas.height - y, region.height + padY * 2);

      // Create canvas from ORIGINAL image (not processed) for better OCR
      const regionCanvas = document.createElement('canvas');
      regionCanvas.width = w;
      regionCanvas.height = h;
      const regionCtx = regionCanvas.getContext('2d')!;
      regionCtx.drawImage(originalCanvas, x, y, w, h, 0, 0, w, h);

      results.push({
        x, y, width: w, height: h,
        imageData: regionCanvas.toDataURL('image/png')
      });
    }

    return results;
  }

  // Clean and validate OCR text
  function cleanOCRText(text: string): string {
    // Remove excessive whitespace and newlines
    let cleaned = text.replace(/\s+/g, ' ').trim();
    // Remove non-printable characters except basic punctuation
    cleaned = cleaned.replace(/[^\x20-\x7E\n\r\t]/g, '');
    return cleaned;
  }

  // Check if text looks like valid text (not garbage)
  function isValidText(text: string): boolean {
    if (!text || text.length < 2) return false;
    // Must have at least some letters
    if (!/[a-zA-Z]/.test(text)) return false;
    // Reject if too many special characters
    const specialChars = text.replace(/[a-zA-Z0-9\s]/g, '').length;
    if (specialChars > text.length * 0.3) return false;
    return true;
  }

  // Run OCR on regions
  async function runOCROnRegions(regions: { x: number, y: number, width: number, height: number, imageData: string }[]): Promise<{ region: typeof regions[0], text: string, confidence: number }[]> {
    const { createWorker } = await import('tesseract.js');
    const worker = await createWorker('eng', 1);

    const results: { region: typeof regions[0], text: string, confidence: number }[] = [];
    let totalRegions = regions.length;

    for (let i = 0; i < regions.length; i++) {
      const region = regions[i];
      updateProgress(`OCR on region ${i + 1}/${totalRegions}...`, 50 + Math.round((i / totalRegions) * 40));

      try {
        const { data } = await worker.recognize(region.imageData);
        const cleanedText = cleanOCRText(data.text);

        // Only add if text is valid and has decent confidence
        if (cleanedText && cleanedText.length > 0 && data.confidence >= 30 && isValidText(cleanedText)) {
          results.push({
            region,
            text: cleanedText,
            confidence: data.confidence
          });
        }
      } catch (e) {
        console.warn('OCR failed for region', i, e);
      }
    }

    await worker.terminate();
    return results;
  }

  // Display detected regions - now just logs (we show bounding boxes on image)
  function displayDetectedRegions(regions: { x: number, y: number, width: number, height: number }[], results?: { text: string, confidence: number }[]) {
