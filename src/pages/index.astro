---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Fontextractor [v2.0.0]">
  <div class="noise-overlay"></div>

  <main class="min-h-screen bg-grid-industrial relative flex flex-col">
    <!-- Header -->
    <header class="p-6 border-b border-[#222] flex justify-between items-center bg-[#050505]/80 backdrop-blur-md sticky top-0 z-40">
      <div class="font-display font-bold text-xl tracking-tighter uppercase flex items-center gap-2">
        <div class="w-3 h-3 bg-primary rounded-full"></div>
        Fontextractor
      </div>
      <div class="font-mono text-xs text-neutral-500 uppercase tracking-widest">
        Sys.Status <span class="text-green-500 ml-1">● Online</span>
      </div>
    </header>

    <!-- Hero -->
    <div class="flex-1 flex flex-col items-center justify-center px-4 py-8 z-10 relative">
      <div class="max-w-5xl w-full">
        <h1 class="font-display text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-extrabold leading-none tracking-tight uppercase mb-4">
          <span class="block">Extract</span>
          <span class="block text-outline hover-text-filled transition-colors duration-300">Typography</span>
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 border-t border-[#222] pt-4">
          <p class="col-span-1 md:col-span-2 text-sm text-neutral-400 max-w-2xl font-mono leading-relaxed">
            Input target URL or upload an image to extract font families.
          </p>
          <div class="col-span-1 flex flex-col gap-2 font-mono text-xs text-neutral-500 uppercase">
            <div class="flex justify-between border-b border-[#222] pb-2">
              <span>Engine</span>
              <span class="text-white">v2.0.0</span>
            </div>
            <div class="flex justify-between border-b border-[#222] pb-2">
              <span>Accuracy</span>
              <span class="text-primary">Enhanced</span>
            </div>
            <div class="flex justify-between pb-2">
              <span>Status</span>
              <span class="text-white">Ready</span>
            </div>
          </div>
        </div>

        <!-- Mode Toggle -->
        <div class="flex gap-2 mb-4">
          <button id="urlModeBtn" class="px-4 py-2 text-xs font-mono uppercase tracking-wider bg-white text-black font-display font-bold transition-colors">
            URL Mode
          </button>
          <button id="imageModeBtn" class="px-4 py-2 text-xs font-mono uppercase tracking-wider border border-[#222] text-neutral-400 hover:border-primary hover:text-primary transition-colors font-display">
            Image Mode
          </button>
        </div>

        <!-- URL Extraction Form -->
        <div id="urlForm" class="bg-[#121212] border border-[#222] p-1 flex flex-col sm:flex-row gap-1 relative group">
          <div class="absolute -inset-0.5 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity blur-lg -z-10"></div>
          <div class="flex-1 flex items-center px-3">
            <span class="font-mono text-neutral-500 mr-2">&gt;</span>
            <input
              type="text"
              id="urlInput"
              placeholder="https://example.com"
              class="w-full bg-transparent border-none outline-none font-mono text-base text-white placeholder-neutral-600 py-3"
            />
          </div>
          <button
            id="extractBtn"
            class="bg-white hover:bg-primary hover:text-white transition-colors text-black font-display font-bold uppercase tracking-wider px-4 py-3 flex items-center justify-center gap-2 cursor-pointer text-sm"
          >
            <span id="btnText">Scan</span>
            <svg id="btnIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            <svg id="loadingIcon" class="w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          </button>
        </div>

        <!-- Recent Scans -->
        <div id="recentScansContainer" class="hidden mt-3 flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="text-neutral-500 uppercase flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Recent:
          </span>
          <div id="recentScansList" class="flex gap-2 flex-wrap"></div>
        </div>

        <!-- Image Upload Form -->
        <div id="imageForm" class="hidden">
          <div class="bg-[#121212] border border-[#222] p-1 flex flex-col gap-1 relative group">
            <div class="absolute -inset-0.5 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity blur-lg -z-10"></div>

            <!-- Upload Area -->
            <div id="dropZone" class="border-2 border-dashed border-[#333] hover:border-primary transition-colors p-6 text-center cursor-pointer">
              <input type="file" id="imageInput" accept="image/*" class="hidden" />
              <div id="uploadPrompt" class="flex flex-col items-center gap-3">
                <svg class="w-10 h-10 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20a2 2 0 01-2-2V6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6z"></path>
                </svg>
                <p class="font-mono text-sm text-neutral-400">Drop image here or <span class="text-primary">browse</span></p>
                <p class="font-mono text-xs text-neutral-600">PNG, JPG, WEBP • Max 10MB</p>
              </div>

              <!-- Selected Image Info -->
              <div id="previewContainer" class="hidden">
                <div class="flex items-center justify-between mb-2">
                  <p id="fileName" class="font-mono text-sm text-neutral-300 truncate flex-1"></p>
                  <button id="clearImageBtn" class="font-mono text-xs text-neutral-500 hover:text-red-500 ml-2">✕ Clear</button>
                </div>
                <div id="imageInfo" class="font-mono text-xs text-neutral-500 mb-2"></div>
              </div>
            </div>

            <!-- Preprocessing Options (inline) -->
            <div id="preprocessingOptions" class="hidden flex flex-wrap items-center gap-4 p-3 border-t border-[#222]">
              <span class="font-mono text-xs text-neutral-500 uppercase">Preprocessing:</span>
              <label class="flex items-center gap-1.5 text-xs font-mono text-neutral-400">
                <input type="checkbox" id="preprocessGrayscale" checked class="accent-primary">
                Grayscale
              </label>
              <label class="flex items-center gap-1.5 text-xs font-mono text-neutral-400">
                <input type="checkbox" id="preprocessContrast" checked class="accent-primary">
                Contrast
              </label>
              <label class="flex items-center gap-1.5 text-xs font-mono text-neutral-400">
                <input type="checkbox" id="preprocessDenoise" checked class="accent-primary">
                Denoise
              </label>
              <label class="flex items-center gap-1.5 text-xs font-mono text-neutral-400">
                <input type="checkbox" id="preprocessThreshold" class="accent-primary">
                Binarize
              </label>
            </div>

            <!-- Processing Progress -->
            <div id="processingProgress" class="hidden p-3 border-t border-[#222]">
              <div class="flex items-center justify-between mb-2">
                <span id="processingStatus" class="font-mono text-xs text-neutral-400">Processing...</span>
                <span id="processingPercent" class="font-mono text-xs text-primary">0%</span>
              </div>
              <div class="h-1 bg-[#222] rounded overflow-hidden">
                <div id="progressBar" class="h-full bg-primary transition-all duration-300" style="width: 0%"></div>
              </div>
            </div>

            <!-- Action Button -->
            <button
              id="ocrBtn"
              class="bg-white hover:bg-primary hover:text-white transition-colors text-black font-display font-bold uppercase tracking-wider px-4 py-3 flex items-center justify-center gap-2 cursor-pointer text-sm"
            >
              <span id="ocrBtnText">Extract Text & Fonts</span>
              <svg id="ocrBtnIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20a2 2 0 01-2-2V6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6z"></path></svg>
              <svg id="ocrLoadingIcon" class="w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </button>
          </div>
        </div>

        <!-- Error State -->
        <div id="errorMessage" class="hidden mt-3 font-mono text-xs text-red-500 border border-red-500/30 bg-red-500/10 p-3">
          [ERROR] Invalid URL or extraction failed.
        </div>

        <!-- Results Area -->
        <div id="resultsArea" class="hidden mt-8">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-[#222] pb-2 mb-4 gap-4">
            <h2 class="font-display text-2xl font-bold uppercase tracking-tight">Extracted Data</h2>
            <div class="flex flex-wrap items-center gap-2">
              <button id="exportTailwindBtn" class="hidden font-mono text-xs text-white border border-[#222] hover:border-primary hover:text-primary transition-colors px-3 py-1 bg-[#121212]">Export Tailwind</button>
              <button id="exportCssBtn" class="hidden font-mono text-xs text-white border border-[#222] hover:border-primary hover:text-primary transition-colors px-3 py-1 bg-[#121212]">Export CSS</button>
              <span id="resultCount" class="font-mono text-sm text-primary border border-primary px-3 py-1 bg-primary/10">0 Fonts Found</span>
            </div>
          </div>

          <!-- Search/Filter Bar -->
          <div id="fontFilterBar" class="flex flex-wrap items-center gap-3 mb-4 p-3 bg-[#121212] border border-[#222]">
            <div class="flex-1 min-w-[200px]">
              <input type="text" id="fontSearchInput" placeholder="Search fonts..." class="w-full bg-[#0a0a0a] border border-[#222] text-white px-3 py-2 font-mono text-sm focus:border-primary outline-none" />
            </div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs text-neutral-500 uppercase">Sort:</span>
              <select id="fontSortSelect" class="bg-[#0a0a0a] border border-[#222] text-white px-2 py-2 font-mono text-xs focus:border-primary outline-none cursor-pointer">
                <option value="original">Original Order</option>
                <option value="az">A-Z</option>
                <option value="za">Z-A</option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <label class="flex items-center gap-1.5 text-xs font-mono text-neutral-400 cursor-pointer">
                <input type="checkbox" id="googleFontsOnly" class="accent-primary">
                Google Fonts Only
              </label>
            </div>
            <span id="fontFilterCount" class="font-mono text-xs text-neutral-500 ml-auto">Showing all</span>
          </div>

          <div id="fontsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Font cards will be injected here -->
          </div>
        </div>

        <!-- Image Preview with Bounding Boxes Overlay -->
        <div id="imagePreviewContainer" class="hidden mt-4">
          <div class="bg-[#121212] border border-[#222] p-4">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-3">
              <div class="flex items-center gap-3">
                <h3 class="font-display text-lg text-white uppercase">Image Preview</h3>
                <span id="imageDimensions" class="font-mono text-xs text-neutral-500"></span>
              </div>
              <div class="flex gap-3">
                <button id="toggleOverlayBtn" class="font-mono text-xs text-neutral-400 hover:text-primary transition-colors">Toggle Boxes</button>
                <button id="manualCropBtn" class="font-mono text-xs text-neutral-400 hover:text-primary transition-colors">Manual Crop</button>
              </div>
            </div>
            <div id="imageWrapper" class="relative inline-block max-w-full overflow-hidden rounded border border-[#222]">
              <img id="originalImagePreview" class="max-w-full h-auto block" alt="Original Image" />
              <canvas id="boundingBoxesCanvas" class="absolute top-0 left-0 w-full h-full pointer-events-none"></canvas>
            </div>
          </div>
        </div>

        <!-- Extracted Text Panel -->
        <div id="extractedTextPanel" class="hidden mt-4">
          <div class="bg-[#121212] border border-[#222] p-4">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
              <h3 class="font-display text-lg text-white uppercase">Extracted Text</h3>
              <div class="flex flex-wrap gap-2">
                <button id="selectAllTextBtn" class="font-mono text-xs bg-[#222] text-neutral-300 hover:bg-primary hover:text-black px-3 py-1 transition-colors">Select All</button>
                <button id="searchTextBtn" class="font-mono text-xs bg-[#222] text-neutral-300 hover:bg-primary hover:text-black px-3 py-1 transition-colors">Search</button>
              </div>
            </div>

            <!-- Search Input -->
            <div id="searchContainer" class="hidden mb-3 flex gap-2">
              <input type="text" id="searchInput" placeholder="Search detected text..." class="flex-1 bg-[#0a0a0a] border border-[#222] text-white px-3 py-2 font-mono text-sm focus:border-primary outline-none" />
              <button id="searchPrevBtn" class="font-mono text-xs text-neutral-400 hover:text-primary px-2">↑</button>
              <button id="searchNextBtn" class="font-mono text-xs text-neutral-400 hover:text-primary px-2">↓</button>
              <span id="searchCount" class="font-mono text-xs text-neutral-500 py-2"></span>
            </div>

            <!-- Selection Info -->
            <div id="selectionInfo" class="hidden mb-3 p-3 bg-[#0a0a0a] border border-[#222]">
              <div class="flex flex-wrap gap-2 items-center justify-between">
                <span id="selectionCount" class="font-mono text-xs text-neutral-400">0 regions selected</span>
                <div class="flex gap-2">
                  <button id="copyPlainTextBtn" class="font-mono text-xs bg-[#222] text-neutral-300 hover:text-primary px-2 py-1 transition-colors">Copy Plain</button>
                  <button id="copyWithBreaksBtn" class="font-mono text-xs bg-[#222] text-neutral-300 hover:text-primary px-2 py-1 transition-colors">Copy with Breaks</button>
                  <button id="copyJsonBtn" class="font-mono text-xs bg-[#222] text-neutral-300 hover:text-primary px-2 py-1 transition-colors">Copy JSON</button>
                </div>
              </div>
            </div>

            <!-- Text Regions List -->
            <div id="textRegionsList" class="space-y-2 max-h-64 overflow-y-auto"></div>

            <!-- Editable Text Output -->
            <div class="mt-4 pt-4 border-t border-[#222]">
              <div class="flex justify-between items-center mb-2">
                <span class="font-mono text-xs text-neutral-500 uppercase">Combined Text</span>
                <button id="copyCombinedBtn" class="font-mono text-xs text-primary hover:underline">Copy All</button>
              </div>
              <textarea id="combinedTextOutput" class="w-full h-32 bg-[#0a0a0a] border border-[#222] text-neutral-300 px-3 py-2 font-mono text-sm resize-y focus:border-primary outline-none" placeholder="Select regions above to combine text..."></textarea>
            </div>

            <!-- Stats -->
            <div class="mt-3 flex flex-wrap gap-4 text-xs font-mono text-neutral-500">
              <span id="totalRegionsStat">Regions: 0</span>
              <span id="totalTextStat">Characters: 0</span>
              <span id="avgConfidenceStat">Avg Confidence: 0%</span>
              <span id="languageStat">Language: English</span>
            </div>
          </div>
        </div>

        <!-- Manual Crop Modal -->
        <div id="manualCropModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
          <div class="bg-[#121212] border border-[#222] w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col">
            <div class="p-4 border-b border-[#222] flex justify-between items-center">
              <h3 class="font-display text-lg text-white uppercase">Manual Crop</h3>
              <button id="closeCropModalBtn" class="text-neutral-500 hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>
            <div class="flex-1 p-4 overflow-auto">
              <div id="cropCanvasWrapper" class="relative inline-block">
                <canvas id="cropCanvas"></canvas>
                <div id="cropSelection" class="absolute border-2 border-primary bg-primary/20 cursor-move hidden"></div>
              </div>
            </div>
            <div class="p-4 border-t border-[#222] flex justify-end gap-3">
              <button id="cancelCropBtn" class="font-mono text-xs text-neutral-400 hover:text-white px-4 py-2 transition-colors">Cancel</button>
              <button id="runOcrOnCropBtn" class="font-display text-xs bg-primary text-black px-6 py-2 hover:opacity-80 transition-colors">Run OCR</button>
            </div>
          </div>
        </div>

        <!-- Font Match Results (New) -->
        <div id="fontMatchResults" class="hidden mt-8">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-[#222] pb-2 mb-4 gap-4">
            <h2 class="font-display text-2xl font-bold uppercase tracking-tight">Font Match Results</h2>
          </div>

          <div id="fontMatchesContainer" class="space-y-4">
            <!-- Font match cards will be injected here -->
          </div>
        </div>

        <!-- Export Modal -->
        <div id="exportModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 opacity-0 transition-opacity duration-300">
          <div class="bg-[#121212] border border-[#222] w-full max-w-2xl relative transform scale-95 transition-transform duration-300" id="exportModalContent">
            <button id="closeExportBtn" class="absolute top-4 right-4 text-neutral-500 hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <div class="p-6 border-b border-[#222]">
              <h3 id="exportModalTitle" class="font-display text-xl text-white uppercase tracking-wider">Export Config</h3>
            </div>
            <div class="p-6 relative">
              <pre class="font-mono text-sm text-green-400 bg-[#050505] p-4 overflow-x-auto border border-[#222] rounded"><code id="exportCode"></code></pre>
            </div>
            <div class="p-6 border-t border-[#222] flex justify-end gap-4">
              <button id="closeExportBtn2" class="text-neutral-400 hover:text-white font-mono text-xs uppercase px-4 py-2 transition-colors">Close</button>
              <button id="copyExportBtn" class="bg-white text-black font-display font-bold uppercase tracking-wider text-xs px-6 py-2 hover:bg-primary hover:text-white transition-colors flex items-center gap-2">
                <span id="copyExportText">Copy Code</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="p-6 border-t border-[#222] flex justify-between items-center text-xs font-mono text-neutral-600 uppercase mt-auto">
      <div>[Fontextractor] &copy; 2026</div>
      <div class="flex gap-4">
        <a href="#" class="hover:text-primary transition-colors">GitHub</a>
        <a href="#" class="hover:text-primary transition-colors">API Docs</a>
      </div>
    </footer>
  </main>
</Layout>

<script>
  // ==================== IMAGE PREPROCESSING ====================

  // Convert image to grayscale
  function toGrayscale(imageData: ImageData): ImageData {
    const data = imageData.data;
    for (let i = 0; i < data.length; i += 4) {
      const gray = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
      data[i] = data[i + 1] = data[i + 2] = gray;
    }
    return imageData;
  }

  // Apply contrast enhancement (CLAHE-style)
  function enhanceContrast(imageData: ImageData, clipLimit: number = 2): ImageData {
    const data = imageData.data;
    const width = imageData.width;
    const height = imageData.height;

    // Build histogram and CDF
    const histogram = new Uint32Array(256);
    for (let i = 0; i < data.length; i += 4) {
      histogram[Math.floor(data[i])]++;
    }

    // CDF
    const cdf = new Uint32Array(256);
    cdf[0] = histogram[0];
    for (let i = 1; i < 256; i++) {
      cdf[i] = cdf[i - 1] + histogram[i];
    }

    // Find CDF min (non-zero)
    let cdfMin = 0;
    for (let i = 0; i < 256; i++) {
      if (cdf[i] > 0) {
        cdfMin = cdf[i];
        break;
      }
    }

    const totalPixels = width * height;
    const scale = 255 / (totalPixels - cdfMin);

    // Apply histogram equalization
    for (let i = 0; i < data.length; i += 4) {
      const val = Math.floor(data[i]);
      const newVal = Math.floor((cdf[val] - cdfMin) * scale);
      data[i] = data[i + 1] = data[i + 2] = Math.max(0, Math.min(255, newVal));
    }

    return imageData;
  }

  // Apply median filter for denoising
  function denoise(imageData: ImageData, radius: number = 1): ImageData {
    const data = imageData.data;
    const width = imageData.width;
    const height = imageData.height;
    const output = new Uint8ClampedArray(data);

    for (let y = radius; y < height - radius; y++) {
      for (let x = radius; x < width - radius; x++) {
        const reds: number[] = [];
        const greens: number[] = [];
        const blues: number[] = [];

        for (let dy = -radius; dy <= radius; dy++) {
          for (let dx = -radius; dx <= radius; dx++) {
            const idx = ((y + dy) * width + (x + dx)) * 4;
            reds.push(data[idx]);
            greens.push(data[idx + 1]);
            blues.push(data[idx + 2]);
          }
        }

        reds.sort((a, b) => a - b);
        greens.sort((a, b) => a - b);
        blues.sort((a, b) => a - b);

        const mid = Math.floor(reds.length / 2);
        const outIdx = (y * width + x) * 4;
        output[outIdx] = reds[mid];
        output[outIdx + 1] = greens[mid];
        output[outIdx + 2] = blues[mid];
      }
    }

    return new ImageData(output, width, height);
  }

  // Apply adaptive thresholding (Otsu's method)
  function threshold(imageData: ImageData): ImageData {
    const data = imageData.data;
    const width = imageData.width;
    const height = imageData.height;

    // Calculate Otsu's threshold
    const histogram = new Uint32Array(256);
    for (let i = 0; i < data.length; i += 4) {
      histogram[Math.floor(data[i])]++;
    }

    let sum = 0;
    for (let i = 0; i < 256; i++) sum += i * histogram[i];

    let sumB = 0;
    let wB = 0;
    let wF = 0;
    let maxVariance = 0;
    let threshold = 0;

    for (let t = 0; t < 256; t++) {
      wB += histogram[t];
      if (wB === 0) continue;
      wF = width * height - wB;
      if (wF === 0) break;

      sumB += t * histogram[t];
      const mB = sumB / wB;
      const mF = (sum - sumB) / wF;
      const variance = wB * wF * (mB - mF) * (mB - mF);

      if (variance > maxVariance) {
        maxVariance = variance;
        threshold = t;
      }
    }

    // Apply threshold
    for (let i = 0; i < data.length; i += 4) {
      const val = data[i] > threshold ? 255 : 0;
      data[i] = data[i + 1] = data[i + 2] = val;
    }

    return imageData;
  }

  // Detect edges using Sobel operator
  function detectEdges(imageData: ImageData): ImageData {
    const data = imageData.data;
    const width = imageData.width;
    const height = imageData.height;
    const output = new Uint8ClampedArray(data.length);

    const sobelX = [-1, 0, 1, -2, 0, 2, -1, 0, 1];
    const sobelY = [-1, -2, -1, 0, 0, 0, 1, 2, 1];

    for (let y = 1; y < height - 1; y++) {
      for (let x = 1; x < width - 1; x++) {
        let gx = 0, gy = 0;

        for (let ky = -1; ky <= 1; ky++) {
          for (let kx = -1; kx <= 1; kx++) {
            const idx = ((y + ky) * width + (x + kx)) * 4;
            const pixel = data[idx];
            const ki = (ky + 1) * 3 + (kx + 1);
            gx += pixel * sobelX[ki];
            gy += pixel * sobelY[ki];
          }
        }

        const magnitude = Math.min(255, Math.sqrt(gx * gx + gy * gy));
        const outIdx = (y * width + x) * 4;
        output[outIdx] = output[outIdx + 1] = output[outIdx + 2] = magnitude;
        output[outIdx + 3] = 255;
      }
    }

    return new ImageData(output, width, height);
  }

  // ==================== TEXT REGION DETECTION ====================

  function findTextRegions(edgeData: ImageData, minWidth: number = 20, minHeight: number = 10): { x: number, y: number, width: number, height: number }[] {
    const data = edgeData.data;
    const width = edgeData.width;
    const height = edgeData.height;
    const visited = new Uint8Array(width * height);
    const regions: { x: number, y: number, width: number, height: number }[] = [];

    // Threshold for edge detection
    const edgeThreshold = 30;

    function floodFill(startX: number, startY: number): { x: number, y: number, width: number, height: number } | null {
      const stack = [[startX, startY]];
      let minX = startX, maxX = startX, minY = startY, maxY = startY;
      let pixelCount = 0;

      while (stack.length > 0 && pixelCount < 5000) {
        const [x, y] = stack.pop()!;
        const idx = y * width + x;

        if (x < 0 || x >= width || y < 0 || y >= height || visited[idx]) continue;
        if (data[idx * 4] < edgeThreshold) continue;

        visited[idx] = 1;
        pixelCount++;

        minX = Math.min(minX, x);
        maxX = Math.max(maxX, x);
        minY = Math.min(minY, y);
        maxY = Math.max(maxY, y);

        stack.push([x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]);
      }

      const w = maxX - minX + 1;
      const h = maxY - minY + 1;

      if (w >= minWidth && h >= minHeight && pixelCount > 20) {
        return { x: minX, y: minY, width: w, height: h };
      }
      return null;
    }

    // Scan for edge pixels and flood fill
    for (let y = 0; y < height; y += 2) {
      for (let x = 0; x < width; x += 2) {
        const idx = y * width + x;
        if (visited[idx]) continue;
        if (data[idx * 4] > edgeThreshold) {
          const region = floodFill(x, y);
          if (region) {
            regions.push(region);
          }
        }
      }
    }

    // Merge overlapping regions
    const merged = mergeOverlappingRegions(regions, 10);

    // Sort by reading order (top-to-bottom, left-to-right)
    merged.sort((a, b) => {
      const rowA = Math.floor(a.y / 50);
      const rowB = Math.floor(b.y / 50);
      if (rowA !== rowB) return rowA - rowB;
      return a.x - b.x;
    });

    return merged.slice(0, 20); // Limit to 20 regions
  }

  function mergeOverlappingRegions(regions: { x: number, y: number, width: number, height: number }[], gap: number): { x: number, y: number, width: number, height: number }[] {
    if (regions.length === 0) return [];

    const sorted = [...regions].sort((a, b) => a.y - b.y);
    const merged: { x: number, y: number, width: number, height: number }[] = [];
    let current = { ...sorted[0] };

    for (let i = 1; i < sorted.length; i++) {
      const next = sorted[i];

      // Check if regions should be merged (close vertically or horizontally)
      const overlapX = current.x < next.x + next.width + gap && current.x + current.width + gap > next.x;
      const overlapY = current.y < next.y + next.height + gap && current.y + current.height + gap > next.y;

      if (overlapX && overlapY) {
        // Merge
        current.x = Math.min(current.x, next.x);
        current.y = Math.min(current.y, next.y);
        current.width = Math.max(current.x + current.width, next.x + next.width) - current.x;
        current.height = Math.max(current.y + current.height, next.y + next.height) - current.y;
      } else {
        merged.push(current);
        current = { ...next };
      }
    }
    merged.push(current);

    return merged;
  }

  // ==================== SIMILARITY METRICS ====================

  // Simple SSIM implementation
  function calculateSSIM(img1: ImageData, img2: ImageData): number {
    if (img1.width !== img2.width || img1.height !== img2.height) return 0;

    const d1 = img1.data;
    const d2 = img2.data;
    let ssim = 0;
    let count = 0;

    const windowSize = 8;
    const c1 = (0.01 * 255) ** 2;
    const c2 = (0.03 * 255) ** 2;

    for (let y = 0; y < img1.height; y += windowSize) {
      for (let x = 0; x < img1.width; x += windowSize) {
        let sum1 = 0, sum2 = 0, sum1sq = 0, sum2sq = 0, sum12 = 0;
        let pixels = 0;

        for (let wy = 0; wy < windowSize && y + wy < img1.height; wy++) {
          for (let wx = 0; wx < windowSize && x + wx < img1.width; wx++) {
            const i1 = ((y + wy) * img1.width + (x + wx)) * 4;
            const i2 = ((y + wy) * img2.width + (x + wx)) * 4;
            const v1 = d1[i1];
            const v2 = d2[i2];

            sum1 += v1;
            sum2 += v2;
            sum1sq += v1 * v1;
            sum2sq += v2 * v2;
            sum12 += v1 * v2;
            pixels++;
          }
        }

        if (pixels === 0) continue;

        const mu1 = sum1 / pixels;
        const mu2 = sum2 / pixels;
        const sigma1 = Math.sqrt(sum1sq / pixels - mu1 * mu1);
        const sigma2 = Math.sqrt(sum2sq / pixels - mu2 * mu2);
        const sigma12 = sum12 / pixels - mu1 * mu2;

        const numerator = (2 * mu1 * mu2 + c1) * (2 * sigma12 + c2);
        const denominator = (mu1 * mu1 + mu2 * mu2 + c1) * (sigma1 * sigma1 + sigma2 * sigma2 + c2);

        ssim += numerator / denominator;
        count++;
      }
    }

    return count > 0 ? ssim / count : 0;
  }

  // Calculate histogram similarity
  function calculateHistogramSimilarity(img1: ImageData, img2: ImageData): number {
    const hist1 = new Uint32Array(256);
    const hist2 = new Uint32Array(256);

    for (let i = 0; i < img1.data.length; i += 4) {
      hist1[img1.data[i]]++;
      hist2[img2.data[i]]++;
    }

    // Normalize
    const total = img1.width * img1.height;
    let similarity = 0;
    for (let i = 0; i < 256; i++) {
      const h1 = hist1[i] / total;
      const h2 = hist2[i] / total;
      similarity += Math.sqrt(h1 * h2);
    }

    return similarity;
  }

