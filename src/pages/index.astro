---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Fontextractor [v1.0.0]">
  <div class="noise-overlay"></div>

  <main class="min-h-screen bg-grid-industrial relative flex flex-col">
    <!-- Header -->
    <header class="p-6 border-b border-[#222] flex justify-between items-center bg-[#050505]/80 backdrop-blur-md sticky top-0 z-40">
      <div class="font-display font-bold text-xl tracking-tighter uppercase flex items-center gap-2">
        <div class="w-3 h-3 bg-primary rounded-full"></div>
        Fontextractor
      </div>
      <div class="font-mono text-xs text-neutral-500 uppercase tracking-widest">
        Sys.Status <span class="text-green-500 ml-1">● Online</span>
      </div>
    </header>

    <!-- Hero -->
    <div class="flex-1 flex flex-col items-center justify-center px-4 py-8 z-10 relative">
      <div class="max-w-5xl w-full">
        <h1 class="font-display text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-extrabold leading-none tracking-tight uppercase mb-4">
          <span class="block">Extract</span>
          <span class="block text-outline hover-text-filled transition-colors duration-300">Typography</span>
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 border-t border-[#222] pt-4">
          <p class="col-span-1 md:col-span-2 text-sm text-neutral-400 max-w-2xl font-mono leading-relaxed">
            Input target URL to extract all font families from any website.
          </p>
          <div class="col-span-1 flex flex-col gap-2 font-mono text-xs text-neutral-500 uppercase">
            <div class="flex justify-between border-b border-[#222] pb-2">
              <span>Engine</span>
              <span class="text-white">v1.0.0</span>
            </div>
            <div class="flex justify-between border-b border-[#222] pb-2">
              <span>Accuracy</span>
              <span class="text-primary">High</span>
            </div>
            <div class="flex justify-between pb-2">
              <span>Status</span>
              <span class="text-white">Ready</span>
            </div>
          </div>
        </div>

        <!-- Mode Toggle -->
        <div class="flex gap-2 mb-4">
          <button id="urlModeBtn" class="px-4 py-2 text-xs font-mono uppercase tracking-wider bg-white text-black font-display font-bold transition-colors">
            URL Mode
          </button>
          <button id="imageModeBtn" class="px-4 py-2 text-xs font-mono uppercase tracking-wider border border-[#222] text-neutral-400 hover:border-primary hover:text-primary transition-colors font-display">
            Image Mode
          </button>
        </div>

        <!-- URL Extraction Form -->
        <div id="urlForm" class="bg-[#121212] border border-[#222] p-1 flex flex-col sm:flex-row gap-1 relative group">
          <div class="absolute -inset-0.5 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity blur-lg -z-10"></div>
          <div class="flex-1 flex items-center px-3">
            <span class="font-mono text-neutral-500 mr-2">&gt;</span>
            <input
              type="text"
              id="urlInput"
              placeholder="https://example.com"
              class="w-full bg-transparent border-none outline-none font-mono text-base text-white placeholder-neutral-600 py-3"
            />
          </div>
          <button
            id="extractBtn"
            class="bg-white hover:bg-primary hover:text-white transition-colors text-black font-display font-bold uppercase tracking-wider px-4 py-3 flex items-center justify-center gap-2 cursor-pointer text-sm"
          >
            <span id="btnText">Scan</span>
            <svg id="btnIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            <svg id="loadingIcon" class="w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          </button>
        </div>

        <!-- Image Upload Form -->
        <div id="imageForm" class="hidden">
          <div class="bg-[#121212] border border-[#222] p-1 flex flex-col gap-1 relative group">
            <div class="absolute -inset-0.5 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity blur-lg -z-10"></div>
            <div id="dropZone" class="border-2 border-dashed border-[#333] hover:border-primary transition-colors p-8 text-center cursor-pointer">
              <input type="file" id="imageInput" accept="image/*" class="hidden" />
              <div id="uploadPrompt" class="flex flex-col items-center gap-3">
                <svg class="w-12 h-12 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20a2 2 0 01-2-2V6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6z"></path>
                </svg>
                <p class="font-mono text-sm text-neutral-400">Drop image here or <span class="text-primary">browse</span></p>
                <p class="font-mono text-xs text-neutral-600">PNG, JPG, WEBP, GIF • Max 10MB</p>
              </div>
              <div id="previewContainer" class="hidden">
                <img id="imagePreview" class="max-h-48 mx-auto rounded mb-3" alt="Preview" />
                <p id="fileName" class="font-mono text-xs text-neutral-500 truncate"></p>
              </div>
            </div>
            <button
              id="ocrBtn"
              class="bg-white hover:bg-primary hover:text-white transition-colors text-black font-display font-bold uppercase tracking-wider px-4 py-3 flex items-center justify-center gap-2 cursor-pointer text-sm"
            >
              <span id="ocrBtnText">Extract Text</span>
              <svg id="ocrBtnIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20a2 2 0 01-2-2V6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6z"></path></svg>
              <svg id="ocrLoadingIcon" class="w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </button>
          </div>
        </div>

        <!-- Error State -->
        <div id="errorMessage" class="hidden mt-3 font-mono text-xs text-red-500 border border-red-500/30 bg-red-500/10 p-3">
          [ERROR] Invalid URL or extraction failed.
        </div>

        <!-- Results Area -->
        <div id="resultsArea" class="hidden mt-8">
          <div class="flex items-center justify-between border-b border-[#222] pb-2 mb-4">
            <h2 class="font-display text-2xl font-bold uppercase tracking-tight">Extracted Data</h2>
            <span id="resultCount" class="font-mono text-sm text-primary border border-primary px-3 py-1 bg-primary/10">0 Fonts Found</span>
          </div>

          <div id="fontsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Font cards will be injected here -->
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="p-6 border-t border-[#222] flex justify-between items-center text-xs font-mono text-neutral-600 uppercase mt-auto">
      <div>[Fontextractor] &copy; 2026</div>
      <div class="flex gap-4">
        <a href="#" class="hover:text-primary transition-colors">GitHub</a>
        <a href="#" class="hover:text-primary transition-colors">API Docs</a>
      </div>
    </footer>
  </main>
</Layout>

<script>
  // @ts-ignore
  import { createWorker, PSM } from 'https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.mjs';

  const input = document.getElementById('urlInput') as HTMLInputElement;
  const btn = document.getElementById('extractBtn') as HTMLButtonElement;
  const btnText = document.getElementById('btnText') as HTMLSpanElement;
  const btnIcon = document.getElementById('btnIcon') as HTMLElement;
  const loadingIcon = document.getElementById('loadingIcon') as HTMLElement;
  const resultsArea = document.getElementById('resultsArea') as HTMLElement;
  const fontsGrid = document.getElementById('fontsGrid') as HTMLElement;
  const resultCount = document.getElementById('resultCount') as HTMLElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLElement;

  // Image mode elements
  const urlModeBtn = document.getElementById('urlModeBtn') as HTMLButtonElement;
  const imageModeBtn = document.getElementById('imageModeBtn') as HTMLButtonElement;
  const urlForm = document.getElementById('urlForm') as HTMLElement;
  const imageForm = document.getElementById('imageForm') as HTMLElement;
  const dropZone = document.getElementById('dropZone') as HTMLElement;
  const imageInput = document.getElementById('imageInput') as HTMLInputElement;
  const uploadPrompt = document.getElementById('uploadPrompt') as HTMLElement;
  const previewContainer = document.getElementById('previewContainer') as HTMLElement;
  const imagePreview = document.getElementById('imagePreview') as HTMLImageElement;
  const fileName = document.getElementById('fileName') as HTMLElement;
  const ocrBtn = document.getElementById('ocrBtn') as HTMLButtonElement;
  const ocrBtnText = document.getElementById('ocrBtnText') as HTMLSpanElement;
  const ocrBtnIcon = document.getElementById('ocrBtnIcon') as HTMLElement;
  const ocrLoadingIcon = document.getElementById('ocrLoadingIcon') as HTMLElement;

  let selectedImage: File | null = null;

  // Mode switching
  function switchMode(mode: 'url' | 'image') {
    if (mode === 'url') {
      urlModeBtn.classList.add('bg-white', 'text-black');
      urlModeBtn.classList.remove('border', 'text-neutral-400');
      imageModeBtn.classList.remove('bg-white', 'text-black', 'border-primary', 'text-primary');
      imageModeBtn.classList.add('border', 'text-neutral-400');
      urlForm.classList.remove('hidden');
      imageForm.classList.add('hidden');
    } else {
      imageModeBtn.classList.add('bg-white', 'text-black');
      imageModeBtn.classList.remove('border', 'text-neutral-400');
      urlModeBtn.classList.remove('bg-white', 'text-black', 'border-primary', 'text-primary');
      urlModeBtn.classList.add('border', 'text-neutral-400');
      urlForm.classList.add('hidden');
      imageForm.classList.remove('hidden');
    }
  }

  urlModeBtn.addEventListener('click', () => switchMode('url'));
  imageModeBtn.addEventListener('click', () => switchMode('image'));

  // Image handling
  function handleImageSelect(file: File) {
    if (!file.type.startsWith('image/')) {
      showError('Please select a valid image file');
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      showError('Image too large. Max size: 10MB');
      return;
    }
    selectedImage = file;
    const reader = new FileReader();
    reader.onload = (e) => {
      imagePreview.src = e.target?.result as string;
      fileName.textContent = file.name;
      uploadPrompt.classList.add('hidden');
      previewContainer.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  }

  dropZone.addEventListener('click', () => imageInput.click());
  imageInput.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleImageSelect(file);
  });

  // Drag and drop
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-primary');
  });
  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-primary');
  });
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-primary');
    const file = e.dataTransfer?.files?.[0];
    if (file) handleImageSelect(file);
  });

  // OCR extraction using Tesseract.js in browser
  async function performOCR() {
    if (!selectedImage) {
      showError('Please select an image first');
      return;
    }

    ocrBtn.disabled = true;
    ocrBtnText.textContent = 'Processing...';
    ocrBtnIcon.classList.add('hidden');
    ocrLoadingIcon.classList.remove('hidden');
    errorMessage.classList.add('hidden');
    resultsArea.classList.add('hidden');

    try {
      // Convert file to base64 data URL
      const reader = new FileReader();
      const imageDataUrl = await new Promise<string>((resolve, reject) => {
        reader.onload = () => resolve(reader.result as string);
        reader.onerror = reject;
        reader.readAsDataURL(selectedImage);
      });

      // Create Tesseract worker
      const worker = await createWorker('eng', 1, {
        logger: (m: any) => {
          if (m.status === 'recognizing text') {
            ocrBtnText.textContent = `${Math.round(m.progress * 100)}%`;
          }
        }
      });

      const { data } = await worker.recognize(imageDataUrl);
      await worker.terminate();

      const extractedText = data.text.trim();

      if (extractedText) {
        resultCount.textContent = `OCR Result • ${Math.round(data.confidence)}% confidence`;
        fontsGrid.innerHTML = '';

        const card = document.createElement('div');
        card.className = 'bg-[#121212] border border-[#222] p-6 hover:border-primary transition-colors';
        card.innerHTML = `
          <div class="font-mono text-[10px] text-neutral-500 mb-4 uppercase flex justify-between">
            <span>Extracted Text</span>
            <span class="text-primary cursor-pointer" id="copyText">Copy</span>
          </div>
          <p class="text-lg text-white font-mono leading-relaxed whitespace-pre-wrap">${extractedText}</p>
        `;

        card.querySelector('#copyText')?.addEventListener('click', () => {
          navigator.clipboard.writeText(extractedText);
          const el = card.querySelector('#copyText')!;
          el.textContent = 'Copied!';
          setTimeout(() => el.textContent = 'Copy', 1500);
        });

        fontsGrid.appendChild(card);
        resultsArea.classList.remove('hidden');
      } else {
        showError('[INFO] No text detected in the image', 'warning');
      }
    } catch (error: any) {
      console.error('OCR Error:', error);
      showError(`[ERROR] ${error.message || 'Failed to process image'}`);
    } finally {
      ocrBtn.disabled = false;
      ocrBtnText.textContent = 'Extract Text';
      ocrLoadingIcon.classList.add('hidden');
      ocrBtnIcon.classList.remove('hidden');
    }
  }

  ocrBtn.addEventListener('click', performOCR);

  function showError(msg: string, type: 'error' | 'warning' = 'error') {
    errorMessage.textContent = msg;
    errorMessage.classList.remove('hidden', 'text-red-500', 'text-yellow-500', 'border-red-500/30', 'border-yellow-500/30', 'bg-red-500/10', 'bg-yellow-500/10');
    if (type === 'warning') {
      errorMessage.classList.add('text-yellow-500', 'border-yellow-500/30', 'bg-yellow-500/10');
    } else {
      errorMessage.classList.add('text-red-500', 'border-red-500/30', 'bg-red-500/10');
    }
  }

  async function performExtraction() {
    const url = input.value.trim();
    if (!url) return;

    // UI Loading state
    btn.disabled = true;
    btnText.textContent = 'Scanning...';
    btnIcon.classList.add('hidden');
    loadingIcon.classList.remove('hidden');
    errorMessage.classList.add('hidden');
    resultsArea.classList.add('hidden');
    fontsGrid.innerHTML = '';

    try {
      const response = await fetch('/api/extract', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Failed to extract fonts');
      }

      if (data.fonts && data.fonts.length > 0) {
        resultCount.textContent = `${data.fonts.length} Fonts Found on ${data.siteTitle || 'Target'}`;
        const displayPreviewText = data.previewText || "The quick brown fox jumps over the lazy dog.";

        data.fonts.forEach((font: string) => {
          const cleanFont = font.replace(/["']/g, '');
          const card = document.createElement('div');
          card.className = 'bg-[#121212] border border-[#222] p-6 hover:border-primary transition-colors group relative overflow-hidden cursor-pointer';

          const bgPattern = document.createElement('div');
          bgPattern.className = 'absolute inset-0 opacity-0 group-hover:opacity-10 transition-opacity bg-[radial-gradient(#ff4f00_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none';
          card.appendChild(bgPattern);

          const fontLink = document.createElement('link');
          fontLink.href = `https://fonts.googleapis.com/css2?family=${cleanFont.replace(/\s+/g, '+')}&display=swap`;
          fontLink.rel = 'stylesheet';
          document.head.appendChild(fontLink);

          card.innerHTML += `
            <div class="relative z-10 pointer-events-none">
              <div class="font-mono text-[10px] text-neutral-500 mb-4 uppercase flex justify-between">
                <span>Family</span>
                <span class="text-primary hidden group-hover:inline-block">Click to Copy CSS</span>
              </div>
              <h3 class="font-display text-2xl text-white mb-2 truncate" title="${cleanFont}">${cleanFont}</h3>
              <p class="text-xl mt-6 line-clamp-3 text-neutral-300" style="font-family: '${cleanFont}', sans-serif;">${displayPreviewText}</p>
            </div>
          `;

          card.addEventListener('click', () => {
            navigator.clipboard.writeText(`font-family: '${cleanFont}';`);
            const header = card.querySelector('h3');
            const originalText = header!.textContent;
            header!.textContent = 'Copied!';
            header!.classList.add('text-primary');
            setTimeout(() => {
              header!.textContent = originalText;
              header!.classList.remove('text-primary');
            }, 1500);
          });

          fontsGrid.appendChild(card);
        });

        resultsArea.classList.remove('hidden');
      } else {
        showError('[INFO] No custom fonts detected at coordinates.', 'warning');
      }

    } catch (error: any) {
      console.error(error);
      showError(`[ERROR] ${error.message}`);
    } finally {
      btn.disabled = false;
      btnText.textContent = 'Initiate Scan';
      loadingIcon.classList.add('hidden');
      btnIcon.classList.remove('hidden');
    }
  }

  btn.addEventListener('click', performExtraction);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') performExtraction();
  });
</script>
